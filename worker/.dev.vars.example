# ═══════════════════════════════════════════════════════════
# SEO Performance Report — fill in the blanks, then save as .dev.vars
#   cp .dev.vars.example .dev.vars
# Never commit .dev.vars
# ═══════════════════════════════════════════════════════════

# --- Secrets (also used with: npx wrangler secret put …) ---
# Bootstrap / create-user gate (NOT daily login). 16+ random chars.
ADMIN_SECRET=PASTE_ADMIN_SECRET_HERE

# HMAC key for session cookies (separate from ADMIN_SECRET). 32+ chars.
SESSION_SIGNING_SECRET=PASTE_SESSION_SIGNING_SECRET_HERE

# Gmail App Password (same as Bulk301) — NOT your normal Gmail password.
SMTP_PASS=PASTE_GMAIL_APP_PASSWORD_HERE

# --- SMTP (non-secret; also in wrangler.toml [vars]) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=aris@casinomcw.com
SMTP_FROM=SEO Report <aris@casinomcw.com>

# --- Local dev ---
APP_URL=http://localhost:5173
PUBLIC_INTERNET=false
COOKIE_SAMESITE=Lax
# IP_ALLOWLIST=
# ALLOWED_ORIGINS=

# --- Live (when domain is ready: copy these into wrangler.toml [vars], then wrangler deploy) ---
# PUBLIC_INTERNET=true
# COOKIE_SAMESITE=None
# APP_URL=https://seoperformancereports.com
# ALLOWED_ORIGINS=https://seoperformancereports.com
# IP_ALLOWLIST=YOUR.PUBLIC.IP
